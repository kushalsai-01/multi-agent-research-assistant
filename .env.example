# ── Groq (free & fast — get key at console.groq.com) ──────────────────────────
GROQ_API_KEY=gsk_your-key-here
# Models: llama-3.3-70b-versatile | mixtral-8x7b-32768 | llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# ── Tavily web search (recommended; DuckDuckGo remains as fallback) ──────────
TAVILY_API_KEY=tvly-your-key-here

# ── PDF RAG (Qdrant Cloud is required in production) ────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=research_documents
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MAX_UPLOAD_MB=20
RAG_CHUNK_TOKENS=320
RAG_CHUNK_OVERLAP=64
RAG_PARENT_TOKENS=1100
RAG_RETRIEVAL_LIMIT=6
RAG_CANDIDATE_LIMIT=30
RAG_MAX_CHUNKS_PER_PAGE=2

# ── Supabase ──────────────────────────────────────────────────────────────────
# Create free project at supabase.com, run docs/supabase_schema.sql
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-key-here

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Sign up free at smith.langchain.com — traces every agent run automatically
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=ai-research-assistant

# ── Frontend deployment ──────────────────────────────────────────────────────
# Comma-separated origins. Add your Vercel URL before deploying the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-project.vercel.app
